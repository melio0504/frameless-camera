CompileFlags:
  Compiler: c++
  Add:
    - -std=c++20
    - -I/usr/include/x86_64-linux-gnu/qt6/QtWidgets
    - -I/usr/include/x86_64-linux-gnu/qt6
    - -I/usr/include/x86_64-linux-gnu/qt6/QtCore
    - -I/usr/lib/x86_64-linux-gnu/qt6/mkspecs/linux-g++
    - -I/usr/include/x86_64-linux-gnu/qt6/QtGui
    - -I/usr/include/x86_64-linux-gnu/qt6/QtMultimedia
    - -I/usr/include/x86_64-linux-gnu/qt6/QtNetwork
    - -I/usr/include/x86_64-linux-gnu/qt6/QtMultimediaWidgets
    - -DQT_MULTIMEDIAWIDGETS_LIB
    - -DQT_MULTIMEDIA_LIB
    - -DQT_NETWORK_LIB
    - -DQT_WIDGETS_LIB
    - -DQT_GUI_LIB
    - -DQT_CORE_LIB
