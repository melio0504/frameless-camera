[Desktop Entry]
Type=Application
Name=Frameless Camera
Comment=Minimal mirrored camera preview
# Replace this with the absolute path to your AppImage.
# Common installation locations include /opt and ~/.local/bin.
# I prefer /opt tho~
Exec=/opt/frameless-camera/frameless-camera-x86_64.AppImage

# Replace this with the absolute path to the SVG icon.
# Keeping the AppImage and icon in the same directory is recommended.
Icon=/opt/frameless-camera/frameless-camera.svg
Terminal=false
Categories=AudioVideo;Video;
Keywords=camera;webcam;preview;
